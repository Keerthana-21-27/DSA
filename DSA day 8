prev=None
curr=head
while curr is not None:
    next_node=curr.next
    curr.next=prev
    prev=curr
    curr=next_node
head=prev
print("Linked List after reverse")
temp=head
while temp is not None:
  print(temp.data,end='->')
  temp=temp.next
print("Tail")
