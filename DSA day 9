##Doubly linked list
#Traversal
class node:
    def __init__(self,data):
        self.data=data
        self.prev=None
        self.next=None
head=None
tail=None
n=int(input("Enter the size of DLL:"))
for i in range(n):
    data=int(input("Enter value:"))
    newnode=node(data)
    if head is None:
        head=newnode
        tail=newnode
    else:
        tail.next=newnode
        newnode.prev=tail
        tail=newnode
print("\nForward traversal:")
temp=head
while temp is not None:
    print(temp.data,end="<->")
    temp=temp.next
print("Tail")
print("\nBackward traversal:")
temp=tail 
while temp is not None:
    print(temp.data,end="<->") 
    temp=temp.prev
print("Tail")

