#Code to read n values and traverse those values and print the counts of even and odd numbers and count them
#arr=[12,3,5,7,9,2] even count=2 and odd count=4
n=int(input("Enter size of array:"))
arr=[]
evencount,oddcount=0,0
for i in range(n):
    num=int(input("Enter a value:"))
    arr.append(num)
for i in range(n):
    if arr[i]%2==0:
        evencount+=1
    else:
        oddcount+=1
print("evencount:",evencount)
print("oddcount:",oddcount)

