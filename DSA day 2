#Equilateral triangle
#code 1
n=int(input("Enter a value:"))
for i in range(n):
    for j in range(2*n-1):
        if i==n-1 or j==n-1-i or j==n-1+i :
            print('*',end=' ')
        else:
            print(' ',end=' ')
    print()
#code 2
n=int(input("Enter a value:"))
for i in range(1,n+1):
    for j in range(n-i):
        print(" ",end=' ')
    for j in range(2*i-1):
        if i==n or j==0 or j==2*i-2 :
            print('*',end=' ')
        else:
            print(' ',end=' ')
    print()
#Inverted equilateral triangle
n=int(input("Enter a value:"))
for i in range(n,0,-1):
    for j in range(n-i):
        print(" ",end=' ')
    for j in range(2*i-1):
        if i==n or i==1 or j==0 or j==2*i-2 :
            print('*',end=' ')
        else:
            print(' ',end=' ')
    print()
#Rhombus
n=int(input("Enter a value:"))
for i in range(1,n+1):
    for j in range(n-i):
        print(" ",end=' ')
    for j in range(2*i-1):
        if j==0 or j==2*i-2 :
            print('*',end=' ')
        else:
            print(' ',end=' ')
    print()
for i in range(n-1,0,-1):
    for j in range(n-i):
        print(" ",end=' ')
    for j in range(2*i-1):
        if i==n or i==1 or j==0 or j==2*i-2 :
            print('*',end=' ')
        else:
            print(' ',end=' ')
    print()
