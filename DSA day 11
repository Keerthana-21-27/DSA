###Parentheses
##Check whether the parentheses are balanced or not
s=input("Enter parentheses:")
stack=[]
for ch in s:
    if ch=='(':
        stack.append(ch)
    elif ch==')':
        if len(stack)==0:
            print("Not balanced")
            break
        stack.pop()
else:
    if len(stack)==0:
        print("Balanced")
    else:
        print("Not balanced")

