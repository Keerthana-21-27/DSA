#deleting parentheses if not balanced
s=input("Enter parentheses:")
stack=[]
result=[]
for ch in s:
    if ch=='(':
        stack.append(len(result))
        result.append(ch)
    elif ch==')':
        if stack:
            stack.pop()
            result.append(ch)
        else:
            continue
for i in reversed(stack):
    result.pop(i)
print("".join(result))

#check parentheses are balanced or not
s=input("Enter parentheses:")
stack=[]
for ch in s:
    if ch=='(' or ch=='[' or ch=='{':
        stack.append(ch)
    elif ch==')' or ch==']' or ch=='}':
        if not stack:
            print("Not balanced")
            break
        top=stack.pop()
        if(ch==')' and top!='(') or (ch==']' and top!='[') or (ch=='}' and top!='{'):
            print("Not balanced")
            break
else:
    if len(stack)==0:
        print(s,"Balanced")
    else:
        print(s,"Not balanced")

